# Supabase — URL + ANON key from Supabase > Settings > API
# (The code reads VITE_SUPABASE_ANON_KEY; the anon key is public by design.)
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

VITE_BACKEND_BASE_URL=http://localhost:8000

# Stripe (publishable key — only needed if using Stripe.js/Elements directly)
# Not required for server-side Checkout redirect flow
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
