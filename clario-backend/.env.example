# ===== REQUIRED =====
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Use the service_role key (not anon) so the backend can call PostgREST without RLS blocking inserts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# JWT secret from Supabase > Settings > API > JWT Settings (used to verify client tokens locally)
SUPABASE_JWT_SECRET=your-jwt-secret-here

GEMINI_API_KEY=your-gemini-api-key-here

# JWT signing key for legacy app tokens — MUST be a long random string in production.
# The app refuses to start with ENV=production unless this is set to a real value.
SECRET_KEY=change-me-to-a-long-random-string

# ===== OPTIONAL =====
# Environment: 'development' or 'production' (default: production for run.py)
ENV=development

# Persistent SQLite path. The default (/tmp/clario.db) is wiped on every restart —
# set this to a persistent volume in production, or migrate to Supabase.
# DB_PATH=/data/clario.db

# Server configuration
HOST=0.0.0.0
PORT=8000

# CORS: Comma-separated list of allowed origins
# Default: http://localhost:3000,http://localhost:5173,http://localhost:8080
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Optional: regex for dev/preview origins (e.g. r"https://.*\.vercel\.app") — leave unset in production
# CORS_PREVIEW_REGEX=

# Optional: model for POST /sessions/{id}/report (default gemini-2.5-flash)
# GEMINI_REPORT_MODEL=gemini-2.5-flash

# ===== PAYMENTS (Dodo) =====
# DODO_API_KEY=your-dodo-api-key
# DODO_WEBHOOK_SECRET=whsec_...   # REQUIRED in production — webhooks fail closed without it
# DODO_LIVE=false                 # set "true" only for real payments
# DODO_PRODUCT_WEEKLY=pdt_...
# DODO_PRODUCT_MONTHLY=pdt_...
# DODO_PRODUCT_YEARLY=pdt_...

# ===== KHALTI (Nepal) =====
# KHALTI_LIVE_SECRET_KEY=...
# KHALTI_TEST_SECRET_KEY=...

# ===== CLOUDINARY (avatars) =====
# CLOUDINARY_CLOUD_NAME=...
# CLOUDINARY_API_KEY=...
# CLOUDINARY_API_SECRET=...
