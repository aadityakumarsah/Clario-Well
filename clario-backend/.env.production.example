
# Clario Backend - PRODUCTION Environment Variables
# Copy to .env and fill in with actual production values
# NEVER commit actual secrets to version control

# ===== REQUIRED =====
SUPABASE_URL=https://your-production-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key-here
SUPABASE_JWT_SECRET=your-production-jwt-secret-here
GEMINI_API_KEY=your-production-gemini-api-key-here

# JWT signing key — MUST be a long random string. The app refuses to start in
# production with the default value (full token-forgery risk).
SECRET_KEY=use-a-long-random-string

# ===== PRODUCTION SETTINGS =====
ENV=production

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Persistent database path — /tmp (the default) is wiped on every restart and
# ALL voice sessions/transcripts are lost. Point this at a persistent volume.
# DB_PATH=/data/clario.db

# CORS: Your production domain(s) - MUST be specific, not wildcards
# Multiple domains: domain1.com,domain2.com
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://api.yourdomain.com

# ===== PAYMENTS (Dodo) — REQUIRED for subscriptions =====
# DODO_API_KEY=your-dodo-api-key
# DODO_WEBHOOK_SECRET=whsec_...   # REQUIRED — webhooks fail closed without it
# DODO_LIVE=true
# DODO_PRODUCT_WEEKLY=pdt_...
# DODO_PRODUCT_MONTHLY=pdt_...
# DODO_PRODUCT_YEARLY=pdt_...

# ===== KHALTI (Nepal) — REQUIRED for Khalti payments =====
# KHALTI_LIVE_SECRET_KEY=...

# ===== CLOUDINARY (avatars) — REQUIRED for avatar uploads =====
# CLOUDINARY_CLOUD_NAME=...
# CLOUDINARY_API_KEY=...
# CLOUDINARY_API_SECRET=...

# Optional: Specific AI model for reports
# GEMINI_REPORT_MODEL=gemini-2.5-flash

# Optional: Monitoring & Logging
# LOG_LEVEL=INFO
# SENTRY_DSN=https://your-sentry-dsn
